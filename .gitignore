venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
logs/

# 星耀数智(AmazingData) 登录凭证，含密码，勿入库
config/amazingdata_auth.json

# 登录鉴权状态（口令哈希/盐/会话密钥），含敏感信息，勿入库
config/auth.json

# 多用户数据库（用户/会话/自选/持仓/流水/设置），含个人信息，勿入库
config/*.db
config/*.db-wal
config/*.db-shm
# 改库前留的临时快照（同样含个人信息）
config/*.db.bak*
config/*.db.bak-*

# 雪球登录凭证 / Cookie / User-Agent，含敏感信息，勿入库
config/xueqiu_auth.json

# 实例级明文配置：模型 API Key、钉钉 webhook 与加签密钥，勿入库。
# 仓库里只保留 *.example.json 空模板；真实值用环境变量或本地未跟踪文件。
config/models.json
config/user_settings.json
!config/*.example.json

# 全市场代码->名称表（运行时缓存，可自动重建，体积大）
config/stock_list_cache.json

# 其它运行时缓存（估值/财报/行业周期/市场周期）：每次跑一次就变，
# 入库会让工作区永远是脏的。可自动重建，不入库。
config/*_cache.json

# 规则文件的可写副本：界面上改四池比例时，decision_rules.update() 会先留
# 一份 .bak 再原子写入（写坏的兜底），属于运行时产物，不入库。
config/*.json.bak
config/*.json.tmp

# 第三方 Python 轮子（体积大，安装后不入库，恢复方式见 README）
wheels/

# IDE / 内部目录
.idea/
.workbuddy/

# 部署用环境变量（含口令/密钥），勿入库
.env
.env.*
!.env.example

# 临时接口调试产物（非源码）
AmazingData_list.json
root_list.json
tgw_list.json


# 本地验收脚本生成的会话令牌，勿入库
test_scripts/.token

# 本地配置备份目录（换机/同步时产生）
config.bak.*/

# 数据库自动备份目录（运维产物，随 config 卷持久化，不入库）
config/backups/

# 便携包构建产物（scripts/build_portable.sh），可随时重建
build/
dist/
