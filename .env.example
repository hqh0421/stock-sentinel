# Web 登录口令（首次启动自动初始化 admin 账号时使用），改成你自己的强口令
APP_PASSWORD=changeme
# 0 = 允许 HTTP 明文会话（本机/内网用）；反向代理上 HTTPS 后改 1
SESSION_SECURE=0

# LLM 对话模型 API Key；到所用 OpenAI 兼容服务商的控制台创建，不使用时留空
MONITOR_STOCK_LLM_API_KEY=
# LLM 视觉模型 API Key；到支持视觉模型的服务商控制台创建，不使用时留空
MONITOR_STOCK_LLM_VISION_API_KEY=
# 钉钉机器人 Webhook 地址；在钉钉群机器人设置中添加自定义机器人后复制，不启用时留空
MONITOR_STOCK_DINGTALK_WEBHOOK_URL=
# 钉钉机器人加签密钥；在同一机器人的安全设置中查看，未启用加签时留空
MONITOR_STOCK_DINGTALK_SECRET=
# 雪球请求 Cookie；登录雪球后从浏览器开发者工具的请求 Cookie 中复制，需要雪球数据时填写
MONITOR_STOCK_XUEQIU_COOKIE=
# 雪球请求 User-Agent；从浏览器开发者工具的请求标头中复制，需要雪球数据时填写
MONITOR_STOCK_XUEQIU_USER_AGENT=
# 模型配置文件路径；填写本机或仓库外的 models.json 路径，留空使用 config/models.json
MONITOR_STOCK_MODELS_FILE=
# 决策规则文件路径；填写本机或仓库外的 decision_rules.json 路径，留空使用 config/decision_rules.json
MONITOR_STOCK_RULES_FILE=
# 决策规则文件 mtime 检查缓存秒数；填写非负数字，留空使用默认值 3 秒
MONITOR_STOCK_RULES_TTL=
